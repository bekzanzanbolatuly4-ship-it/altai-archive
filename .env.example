ARCHIVE_OWNER_EMAIL=owner@example.org
ARCHIVE_OWNER_PASSWORD=replace-with-a-strong-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
UPLOAD_LIMIT_MB=25
# Informational demo: blocks archive content, account and export mutations.
DEMO_READ_ONLY=true

# Local development defaults. On Vercel set both origins to the exact deployed HTTPS origin.
# APP_ORIGIN is required by same-origin request validation in production.
APP_ORIGIN=http://127.0.0.1:3000
# Public origin for sitemap and canonical/Open Graph metadata; must match APP_ORIGIN in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Server-only Google AI Studio key. Never use a NEXT_PUBLIC_ prefix.
# Current model: gemini-3.1-flash-lite. Google AI Studio free-tier content may be used to improve Google products.
GEMINI_API_KEY=
# Optional distributed public AI limiter (required in production when AI is enabled on Vercel).
# Create a dedicated Redis database and set both values in the host secret manager.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Feedback review access only. Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://isokkxsuqmcsaumbtxlt.supabase.co
SUPABASE_SECRET_KEY=
# Optional legacy server-side key name during migration; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Visitor Supabase Auth. Publishable key is public by design; never use a secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://isokkxsuqmcsaumbtxlt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-publishable-key
