ARCHIVE_OWNER_EMAIL=owner@example.org
ARCHIVE_OWNER_PASSWORD=replace-with-a-strong-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
UPLOAD_LIMIT_MB=25
# Informational demo: blocks archive content, account and export mutations.
DEMO_READ_ONLY=true

# Local development defaults. On Vercel set both origins to the exact deployed HTTPS origin.
# APP_ORIGIN is required by same-origin request validation in production.
APP_ORIGIN=http://127.0.0.1:3000
# Public origin for sitemap and canonical/Open Graph metadata; must match APP_ORIGIN in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Server only. Leave blank for unavailable state plus optional local demo.
# Supported: openrouter (free router or a free model ID), gemini (Google Gemini API).
# Gemini unpaid-tier content may be used to improve Google products; require archive privacy approval before enabling.
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=openrouter/free
# Legacy OpenRouter aliases remain supported during migration; do not set both forms.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional distributed public AI limiter (required in production when AI is enabled on Vercel).
# Create a dedicated Redis database and set both values in the host secret manager.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
